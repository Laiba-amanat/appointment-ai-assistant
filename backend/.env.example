# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/appointment_ai

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_use_a_long_random_string_32_chars_minimum
JWT_EXPIRES_IN=7d

# ── AI — Groq (free tier) ───────────────────────────────
# Get free key at https://console.groq.com → API Keys
GROQ_API_KEY=CHANGE_ME_your_groq_key_gsk_...
GROQ_MODEL=llama-3.1-8b-instant

# ── CORS ────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── Rate Limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
